# Copy this file to .env.local and fill in your values. Everything is optional:
# without a value the related feature simply stays off.

# Your live domain, used for SEO, sitemap and payment redirects.
NEXT_PUBLIC_SITE_URL=https://www.portugaliptv.top

# Stripe payments (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Emails via Resend (https://resend.com/api-keys)
RESEND_API_KEY=
EMAIL_FROM=Portugal IPTV <suporte@portugaliptv.top>
ADMIN_EMAIL=you@example.com

# Google Search Console "HTML tag" verification code (only the content="..." value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics (only loaded after the visitor accepts cookies)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
